<mvc:View controllerName="copacol.controller.Z_COPACOL"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:custom="http://schemas.sap.com/ui/custom">
    
    <m:SplitApp id="SplitAppDemo" initialDetail="defaultDetailPage" initialMaster="master">
        <!-- Master Pages -->
        <m:masterPages>
            <m:Page id="master" title="Tutoriais" backgroundDesign="Solid">
                <m:List>
                    <m:StandardListItem 
                        title="Admissão Eletrônica" 
                        type="Navigation" 
                        press=".onListItemPress" 
                        custom:targetPage="admissaoPage" />
                        
                    <m:StandardListItem 
                        title="APP Canhotos" 
                        type="Navigation" 
                        press=".onListItemPress" 
                        custom:targetPage="canhotosPage" />
                </m:List>
            </m:Page>
        </m:masterPages>

        <!-- Detail Pages -->
        <m:detailPages>
            <m:Page id="defaultDetailPage" title="Copacol" backgroundDesign="Solid">
                <m:Label text="Selecione uma opção no menu." />
            </m:Page>
            <m:Page id="admissaoPage" title="Admissão Eletrônica" backgroundDesign="Solid">
                <m:Label text="Bem-vindo à Admissão Eletrônica!" />
            </m:Page>
            <m:Page id="canhotosPage" title="APP Canhotos" backgroundDesign="Solid">
                <m:Label text="Bem-vindo ao APP Canhotos!" />
            </m:Page>
        </m:detailPages>
    </m:SplitApp>
</mvc:View>
