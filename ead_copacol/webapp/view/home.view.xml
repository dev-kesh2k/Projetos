<mvc:View controllerName="eadcopacol.controller.home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:custom="http://schemas.sap.com/ui/custom">
    
    <m:SplitApp id="SplitApp" initialDetail="defaultDetailPage" initialMaster="master">
        <!-- Master Pages -->
        <m:masterPages>
            <m:Page id="master" title="Tutoriais" backgroundDesign="Solid">
                <m:List>
                    <m:StandardListItem 
                        title="Salesforce" 
                        type="Navigation" 
                        press=".onListItemPress" 
                        custom:targetViewName="eadcopacol.view.admissao.eletronica" />

                    <m:StandardListItem 
                        title="SAP" 
                        type="Navigation" 
                        press=".onListItemPress" 
                        custom:targetViewName="eadcopacol.view.admissao.eletronica" />

                    <m:StandardListItem 
                        title="Admissão Eletrônica" 
                        type="Navigation" 
                        press=".onListItemPress" 
                        custom:targetViewName="eadcopacol.view.admissao.eletronica" />

                    <m:StandardListItem 
                        title="APP Canhotos" 
                        type="Navigation" 
                        press=".onListItemPress" 
                        custom:targetViewName="eadcopacol.view.canhoto" />
                    
                        <m:StandardListItem 
                        title="Catálago de serviços de TI " 
                        type="Navigation" 
                        press=".onListItemPress" 
                        custom:targetViewName="eadcopacol.view.canhoto" />
                        
                        <m:StandardListItem 
                        title="Chatbot" 
                        type="Navigation" 
                        press=".onListItemPress" 
                        custom:targetViewName="eadcopacol.view.canhoto" />
                        
                        <m:StandardListItem 
                        title="EasyPac" 
                        type="Navigation" 
                        press=".onListItemPress" 
                        custom:targetViewName="eadcopacol.view.canhoto" />
                        
                        <m:StandardListItem 
                        title="Fiori" 
                        type="Navigation" 
                        press=".onListItemPress" 
                        custom:targetViewName="eadcopacol.view.canhoto" />
                        
                        <m:StandardListItem 
                        title="Is Collector" 
                        type="Navigation" 
                        press=".onListItemPress" 
                        custom:targetViewName="eadcopacol.view.canhoto" />    

                        <m:StandardListItem 
                        title="Mercado Eletrônico" 
                        type="Navigation" 
                        press=".onListItemPress" 
                        custom:targetViewName="eadcopacol.view.canhoto" />  

                        <m:StandardListItem 
                        title="Nota Fiscal de Serviço" 
                        type="Navigation" 
                        press=".onListItemPress" 
                        custom:targetViewName="eadcopacol.view.canhoto" />  

                        <m:StandardListItem 
                        title="VetorH" 
                        type="Navigation" 
                        press=".onListItemPress" 
                        custom:targetViewName="eadcopacol.view.canhoto" />  
                </m:List>
            </m:Page>
        </m:masterPages>

        <!-- Detail Pages -->
        <m:detailPages>
            <m:Page id="defaultDetailPage" title="Copacol" backgroundDesign="Solid">
                <m:Label text="Selecione uma opção no menu." />
            </m:Page>
        </m:detailPages>
    </m:SplitApp>
</mvc:View>
